# Rust / Cargo (workspace root targets all crates)
/target/

# Agent side storage (checkpoints, local metadata)
.deep-code/

# Eval rollout output (regenerated per run; a full split carries 300 patches
# plus their transcripts). Receipts for a PUBLISHED number get copied into
# docs/eval/<run_id>/ deliberately, not tracked from the working directory.
/eval-out/

# --- Node (npm launcher package) ---
node_modules/

# npm installer fetches the platform binary next to the launcher at install
# time; never commit it (the launcher bin/deepcode itself IS tracked).
/packages/deepcode/bin/deepcode-bin
/packages/deepcode/bin/deepcode.exe
# Staging files the installer renames into place / cleans up on failure.
/packages/deepcode/bin/*.download
/packages/deepcode/bin/*.SHA256SUMS

# --- Local env & secrets ---
.env
.env.*
!.env.example

# --- OS ---
.DS_Store
Thumbs.db

# --- Logs ---
*.log
npm-debug.log*

# --- IDE ---
.idea/
.vscode/*
!.vscode/extensions.json
*.sw?
