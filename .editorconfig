root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.rs]
indent_style = space
indent_size = 4
tab_width = 4

[*.{ts,tsx,js,jsx,cjs,mjs,mts,cts,json,jsonc,css,html}]
indent_style = space
indent_size = 2
tab_width = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.toml]
indent_style = space
indent_size = 2
