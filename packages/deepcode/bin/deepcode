#!/usr/bin/env node
// Cross-platform launcher for the deepcode CLI.
//
// `install.mjs` downloads the platform's prebuilt Rust binary next to this file
// (`deepcode-bin` on Unix, `deepcode.exe` on Windows). This launcher is what
// `package.json` `bin` points at and is shipped in the tarball, so npm's bin
// link always targets a real file — Windows no longer depends on PATHEXT
// resolving an extension-less name, and `--ignore-scripts` installs fail loudly
// instead of leaving a command pointing at nothing.
'use strict';

const { spawn } = require('node:child_process');
const { existsSync } = require('node:fs');
const { basename, join } = require('node:path');
const os = require('node:os');

const binary = join(
  __dirname,
  process.platform === 'win32' ? 'deepcode.exe' : 'deepcode-bin',
);

// The binary prints its own name in `--help`, `--version`, every usage line and
// every "Try `… --help`" error, and it reads that name from argv[0]. Spawned
// from here, argv[0] is `deepcode-bin` — the deliberately distinct download
// name, which is on nobody's PATH — so the first lines a new user reads told
// them to run a command that does not exist. This launcher is the only thing
// that knows the name npm actually linked, so it hands it over. `argv[1]` is
// this script's own path, which IS that name.
const invokedAs = basename(process.argv[1] || 'deepcode');

if (!existsSync(binary)) {
  console.error('deepcode: native binary not found.');
  console.error('Reinstall without --ignore-scripts, or grab a prebuilt binary from');
  console.error('https://github.com/liwenka1/deep-code/releases');
  process.exit(1);
}

// `spawn`, not `spawnSync`: a supervisor (or `timeout`, or a closed shell) that
// sends SIGTERM/SIGHUP to THIS launcher would, with spawnSync, kill only Node —
// the native binary is reparented to init and keeps running, orphaning its job
// process groups (dev servers, watchers). Async spawn lets us forward those
// signals so the binary runs its own graceful shutdown. (SIGINT/Ctrl-C already
// reaches the whole foreground group; forwarding it too is harmless — the binary
// guards against a double interrupt — and covers a supervisor that signals only
// this pid.)
const child = spawn(binary, process.argv.slice(2), {
  stdio: 'inherit',
  env: { ...process.env, DEEP_CODE_PROGRAM_NAME: invokedAs },
});

const forward = (signal) => {
  try {
    child.kill(signal);
  } catch {
    /* child already gone — nothing to forward to */
  }
};
for (const signal of ['SIGINT', 'SIGTERM', 'SIGHUP']) {
  process.on(signal, () => forward(signal));
}

child.on('error', (error) => {
  console.error(`deepcode: failed to launch binary: ${error.message}`);
  process.exit(1);
});

child.on('exit', (code, signal) => {
  // Mirror the child's fate. A signal exit becomes the shell convention 128+n so
  // the parent sees the real cause; a normal exit passes its code through.
  if (signal) {
    process.exit(128 + (os.constants.signals[signal] || 0));
  }
  process.exit(code === null ? 1 : code);
});
